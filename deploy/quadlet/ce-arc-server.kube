# Podman Quadlet — user unit (rootless).
# Requires Podman >= 4.8 (Secret YAML support in podman play kube).
#
# Installation — handled by setup.sh:
#   bash deploy/quadlet/setup.sh
#
# Manual installation:
#   mkdir -p ~/.config/containers/systemd
#   cp deploy/quadlet/{ce-arc-server.kube,ce-arc-server-pod.yml,ce-arc-server-config.yml} \
#       ~/.config/containers/systemd/
#   # copy the generated secret file (NOT the .tpl):
#   install -m 600 deploy/quadlet/ce-arc-server-secret.yml ~/.config/containers/systemd/
#   systemctl --user daemon-reload
#   systemctl --user enable --now ce-arc-server

[Unit]
Description=ce-arc-server — GitHub Actions Runner Controller webhook server
Documentation=https://github.com/jaquiteme/container-engine-actions-runner-controller
After=network-online.target
Wants=network-online.target

[Kube]
# Kubernetes Pod definition (generated from .tpl by setup.sh).
Yaml=ce-arc-server-pod.yml

# Non-sensitive configuration — Kubernetes ConfigMap kind.
ConfigMap=ce-arc-server-config.yml

# Sensitive configuration — Kubernetes Secret kind.
# Podman 4.8+ processes both ConfigMap and Secret YAML via this directive.
# This file is generated by setup.sh from environment variables and is gitignored.
ConfigMap=ce-arc-server-secret.yml

# Keep the invoking user's UID mapped 1:1 inside the container namespace so the
# process can access the rootless Podman socket owned by that UID on the host.
PodmanArgs=--userns=keep-id

# Publish the webhook port. Override PORT in the ConfigMap to change the value.
PublishPort=3000:3000

[Service]
Restart=on-failure
RestartSec=10s
TimeoutStartSec=60

[Install]
WantedBy=default.target
